<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="36dp" android:text="@string/medicine_time_title" android:textColor="@color/teal_dark" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/timeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="18dp" android:textColor="@color/navy" android:textSize="42sp" android:textStyle="bold" />
        <TextView android:id="@+id/pillText" android:layout_width="230dp" android:layout_height="82dp" android:layout_marginTop="26dp" android:background="@drawable/bg_pill" android:gravity="center" android:maxLines="2" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/pill_placeholder" android:textAlignment="center" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/medicineNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="20dp" android:textColor="@color/navy" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/dosageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="16sp" />
        <TextView android:id="@+id/mealText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="22dp" android:background="@drawable/bg_soft" android:padding="15dp" android:textColor="@color/navy" android:textSize="17sp" android:textStyle="bold" />
        <Button android:id="@+id/speakButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="16dp" android:background="@drawable/bg_outline_button" android:text="@string/listen_again" android:textAllCaps="false" android:textColor="@color/teal_dark" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <Button android:id="@+id/takenButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="24dp" android:background="@drawable/bg_teal_button" android:text="@string/i_took_medicine" android:textAllCaps="false" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold" />
        <Button android:id="@+id/snoozeButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_outline_button" android:text="@string/snooze_ten_minutes" android:textAllCaps="false" android:textColor="@color/navy_soft" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
