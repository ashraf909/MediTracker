<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/patient_profile"
        android:textColor="@color/navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/patient_profile_description"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/MediTrackerInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/patient_name">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/MediTrackerInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/age">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editPatientAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="@string/language_title" android:textColor="@color/navy" android:textSize="14sp" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/languageGroup"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        app:checkedButton="@id/languageEnglishButton" app:selectionRequired="true" app:singleSelection="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/languageEnglishButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="@string/language_english" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/languageBanglaButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="@string/language_bangla" android:textAllCaps="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
